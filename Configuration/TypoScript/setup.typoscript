# llms.txt v2 link relations: "alternate" to the Markdown version of this page,
# "describedby" to the llms.txt covering it. Rendered per page, so both know the
# page's own URL and the base of its language.
page {
    headerData {
        1761744920 = USER
        1761744920 {
            userFunc = WebNomads\WnAiBridge\Controller\LlmsTxtController->renderLinkRelations
        }
    }
}

llmstxt = PAGE
llmstxt {
    typeNum = 1699

    config {
        disableAllHeaderCode = 1
        additionalHeaders.10 {
            header = Content-Type: text/plain; charset=utf-8
            replace = 1
        }
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 0
    }

    10 = USER
    10 {
        userFunc = WebNomads\WnAiBridge\Controller\LlmsTxtController->generateAction
    }
}

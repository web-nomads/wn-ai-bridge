	<file source-language="en" datatype="plaintext" original="EXT:wn_ai_bridge/Resources/Private/Language/locallang.xlf" date="2025-07-21T12:00:00Z">
		<header>
			<description>Language labels for AI Bridge extension</description>
		</header>
		<body>
			<trans-unit id="module.title">
				<source>AI Bridge</source>
			</trans-unit>
			<trans-unit id="module.description">
				<source>Generate and manage .well-known/llm.txt files</source>
			</trans-unit>
			<trans-unit id="scheduler.task.title">
				<source>Generate LLMS TXT file</source>
			</trans-unit>
			<trans-unit id="scheduler.task.description">
				<source>Periodically generate the .well-known/llm.txt file based on extension configuration</source>
			</trans-unit>
			<trans-unit id="file.exists">
				<source>File exists</source>
			</trans-unit>
			<trans-unit id="file.not_exists">
				<source>File does not exist</source>
			</trans-unit>
			<trans-unit id="file.path">
				<source>File path</source>
			</trans-unit>
			<trans-unit id="file.last_modified">
				<source>Last modified</source>
			</trans-unit>
			<trans-unit id="file.size">
				<source>File size</source>
			</trans-unit>
			<trans-unit id="action.generate">
				<source>Generate File</source>
			</trans-unit>
			<trans-unit id="action.preview">
				<source>Preview</source>
			</trans-unit>
			<trans-unit id="action.validate">
				<source>Validate</source>
			</trans-unit>
			<trans-unit id="configuration.title">
				<source>Configuration</source>
			</trans-unit>
			<trans-unit id="configuration.contact_email">
				<source>Contact Email</source>
			</trans-unit>
			<trans-unit id="configuration.license">
				<source>License</source>
			</trans-unit>
			<trans-unit id="configuration.topics">
				<source>Topics</source>
			</trans-unit>
			<trans-unit id="configuration.include_paths">
				<source>Include Paths</source>
			</trans-unit>
			<trans-unit id="configuration.exclude_paths">
				<source>Exclude Paths</source>
			</trans-unit>
			<trans-unit id="configuration.llm_policy">
				<source>LLM Policy</source>
			</trans-unit>
			<trans-unit id="configuration.custom_headers">
				<source>Custom Headers</source>
			</trans-unit>
			<trans-unit id="validation.errors">
				<source>Validation Errors</source>
			</trans-unit>
			<trans-unit id="validation.warnings">
				<source>Validation Warnings</source>
			</trans-unit>
			<trans-unit id="validation.success">
				<source>No validation issues found</source>
			</trans-unit>
			<trans-unit id="site.tab.llmstxt">
				<source>LLMS.TXT Configuration</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtEnabled">
				<source>Enable LLMS.TXT Generation</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtEnabled.description">
				<source>Enable automatic generation of llms.txt file for this site</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtTitle">
				<source>Site Title Override</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtTitle.description">
				<source>Override the homepage title for llms.txt. Leave empty to use the page title.</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtTitle.placeholder">
				<source>e.g., University of Worms - Study Programs &amp; Research</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtDescription">
				<source>Site Description Override</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtDescription.description">
				<source>Override the homepage description for llms.txt. Leave empty to use the page description.</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtAdditionalInfo">
				<source>Additional Information (Markdown)</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtAdditionalInfo.description">
				<source>Add custom content to llms.txt in Markdown format. This will be appended after the navigation structure. Use this for special instructions, policies, or additional context for LLMs.</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtContactEmail">
				<source>Contact Email</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtContactEmail.description">
				<source>Contact email for inquiries about the site content</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtKeywords">
				<source>Keywords/Topics</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtKeywords.description">
				<source>Comma-separated keywords or topics that describe your site (e.g., "higher education, computer science, business administration")</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtKeywords.placeholder">
				<source>higher education, research, international programs</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtMaxDepth">
				<source>Navigation Depth</source>
			</trans-unit>
			<trans-unit id="site.llmsTxtMaxDepth.description">
				<source>Maximum depth of page hierarchy to include in navigation (1-5 levels)</source>
			</trans-unit>
			<trans-unit id="site.tab.assistant">
				<source>AI Search Assistant</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantEnabled">
				<source>Enable AI Search Assistant</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantEnabled.description">
				<source>Show the floating chat assistant on this site (requires the global assistant switch in the extension configuration).</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantTitle">
				<source>Assistant Title</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantTitle.description">
				<source>Heading shown in the assistant window. Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantWelcome">
				<source>Welcome Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantWelcome.description">
				<source>First message the assistant shows when the window is opened.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantPlaceholder">
				<source>Input Placeholder</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantPlaceholder.description">
				<source>Placeholder text shown in the question input field.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAvatar">
				<source>Logo / Photo</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAvatar.description">
				<source>Optional image shown as a round avatar in the assistant (header, floating button and next to answers). Enter a path or URL: e.g. "fileadmin/logo.png", "EXT:my_ext/Resources/Public/Images/bot.png" or "https://example.com/logo.png".</source>
			</trans-unit>
			<trans-unit id="site.tab.assistantColors">
				<source>AI Assistant Colors</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAccentColor">
				<source>Accent Color</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAccentColor.description">
				<source>Accent color for the toggle button, send button and focus highlights (hex, e.g. #2563eb). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantBgColor">
				<source>Background Color</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantBgColor.description">
				<source>Background color of the chat window and input (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantTextColor">
				<source>Text Color</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantTextColor.description">
				<source>Text color for the frame, header, close button and general UI text (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserBgColor">
				<source>Background Color User Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserBgColor.description">
				<source>Background color of the visitor's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserTextColor">
				<source>Text Color User Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserTextColor.description">
				<source>Text color of the visitor's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserLinkColor">
				<source>Link Color User Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantUserLinkColor.description">
				<source>Link color inside the visitor's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantBgColor">
				<source>Background Color Assistant Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantBgColor.description">
				<source>Background color of the assistant's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantTextColor">
				<source>Text Color Assistant Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantTextColor.description">
				<source>Text color of the assistant's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantLinkColor">
				<source>Link Color Assistant Message</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAssistantLinkColor.description">
				<source>Link color inside the assistant's message bubbles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesBgColor">
				<source>Background Color Sources</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesBgColor.description">
				<source>Background color of the source result cards (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesTextColor">
				<source>Text Color Sources</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesTextColor.description">
				<source>Text color of the source snippets (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesLinkColor">
				<source>Link Color Sources</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSourcesLinkColor.description">
				<source>Link color of the source titles (hex). Leave empty for the default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantCustomCss">
				<source>Custom CSS File</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantCustomCss.description">
				<source>Optional path or URL to your own CSS file, loaded after the widget's default styles so your rules win. E.g. "fileadmin/assistant.css", "EXT:my_ext/Resources/Public/Css/assistant.css" or "https://example.com/assistant.css". Scope selectors under #wn-ai-assistant.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAutoOpen">
				<source>Open Automatically</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAutoOpen.description">
				<source>Automatically open the assistant overlay after a delay when a visitor lands on a page. It will not reopen after the visitor closes it during the same visit.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAutoOpenDelay">
				<source>Auto-Open Delay (seconds)</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantAutoOpenDelay.description">
				<source>Number of seconds to wait before the overlay opens automatically (0 = immediately).</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSystemPrompt">
				<source>Additional Instructions</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSystemPrompt.description">
				<source>Extra instructions for the assistant (persona, tone, what to recommend). Appended to the base system prompt. Only used when an LLM API key is configured.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantOnePager">
				<source>OnePager Mode</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantOnePager.description">
				<source>Enable if this site is a OnePager (sub-pages are rendered as sections on the homepage). Result links to direct children of the site root then use anchors (e.g. "/#customers") instead of separate sub-page URLs.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantLearning">
				<source>Learn from visitor corrections</source>
			</trans-unit>
			<trans-unit id="site.language.assistantText">
				<source>Optional value for this language. Leave empty to use the site-level value (and finally the bundled translation).</source>
			</trans-unit>
			<trans-unit id="site.language.llmsText">
				<source>Optional value for this language. Leave empty to use the site-level (default language) value.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantLearning.description">
				<source>When enabled, a correction a visitor makes to an answer is captured for review in the "Answers" backend module. Only corrections you approve are used in future answers (and only when a question thematically matches). Off by default.</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSearchPid">
				<source>Search Root Page</source>
			</trans-unit>
			<trans-unit id="site.aiAssistantSearchPid.description">
				<source>Optional page id to restrict the search to a subtree. 0 = search the whole site.</source>
			</trans-unit>
		</body>
	</file>
</xliff>

				<source>Bot Access Log</source>
				<target>Registro degli accessi dei bot</target>
			</trans-unit>
			<trans-unit id="mlang_labels_tabdescr">
				<source>See when bots and crawlers access your llms.txt, the Markdown (.md) versions and normal pages. Filterable per type, bot and IP.</source>
				<target>Mostra quando bot e crawler accedono al file llms.txt, alle versioni Markdown (.md) e alle pagine normali. Filtrabile per tipo, bot e IP.</target>
			</trans-unit>
